      "seed": 702159992,
      "version": 3,
      "versionNonce": 826996488,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793338958367,
      "link": null,
      "locked": false,
      "text": " npx plx connect (run once on B)\n 1. Sign in: browser, or over SSH open the link\n    anywhere, allow, paste the code shown\n 2. Install ~/.parallax-plxd + service (0072)\n 3. relay/register; plxd records account sub\n 4. Turn on relay and remote; approve the first\n    device with Enter when its code matches\n Also: plx connect unlink | remove | status | add",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "plxc",
      "originalText": " npx plx connect (run once on B)\n 1. Sign in: browser, or over SSH open the link\n    anywhere, allow, paste the code shown\n 2. Install ~/.parallax-plxd + service (0072)\n 3. relay/register; plxd records account sub\n 4. Turn on relay and remote; approve the first\n    device with Enter when its code matches\n Also: plx connect unlink | remove | status | add",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Zm5AUFSliAMaBCQ3cRluE",
      "type": "text",
      "x": 1515,
      "y": 613,
      "width": 322.9892578125,
      "height": 337.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
