      "link": null,
      "locked": false,
      "text": " Worker (router)\n POST /v1/hosts: register, key-signed\n GET /v1/hosts: the account's host list\n GET /connect/:hostId: Clerk token, no ticket\n DELETE /v1/hosts/:id: remove a host\n GET /connect/code: shows a sign-in code to paste",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
