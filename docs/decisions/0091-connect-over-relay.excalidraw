    {
      "id": "jFUa4CNb8raVA68Js0M1j",
      "type": "text",
      "x": 55,
      "y": 405,
      "width": 386.3671875,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
