      "link": null,
      "locked": false,
      "text": " Worker (router)\n POST /v1/hosts: register, key-signed\n GET /v1/hosts: the account's host list\n GET /v1/hosts/:id/connect: token header, no ticket\n DELETE /v1/hosts/:id: remove a host\n GET /connect/code: shows a sign-in code to paste",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "worker",
      "originalText": " Worker (router)\n POST /v1/hosts: register, key-signed\n GET /v1/hosts: the account's host list\n GET /v1/hosts/:id/connect: token header, no ticket\n DELETE /v1/hosts/:id: remove a host\n GET /connect/code: shows a sign-in code to paste",
      "autoResize": true,
      "lineHeight": 1.25
