    {
      "id": "XVMzU-09mYsvGwxDqqzlq",
      "type": "text",
      "x": 1515,
      "y": 405,
      "width": 340.751953125,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
