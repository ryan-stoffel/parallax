    {
      "id": "B3UXenb_xNXWTMO5pK7wn",
      "type": "text",
      "x": 1515,
      "y": 405,
      "width": 340.751953125,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
