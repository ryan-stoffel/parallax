      "boundElements": null,
      "updated": 1793335159346,
      "link": null,
      "locked": false,
      "text": " Host object (one per host)\n - owner key (JWK)\n - plxd's control socket\n - tickets, max 16 streams\n - 2 GiB a day\n - held webhooks, 24 h\n - pushes, no content",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
