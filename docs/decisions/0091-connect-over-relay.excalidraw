      "seed": 393006933,
      "version": 3,
      "versionNonce": 625239675,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793371563945,
      "link": null,
      "locked": false,
      "text": " npx plx connect (run once on B)\n 1. Sign in: browser, or over SSH open the link\n    anywhere, allow, paste the code shown\n 2. Install ~/.parallax-plxd + service (0072)\n 3. relay/register; plxd records account sub\n 4. Turn on relay and remote; show a 6-digit\n    code to type in the app on another device\n Also: plx connect unlink | remove | status | add",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "plxc",
      "originalText": " npx plx connect (run once on B)\n 1. Sign in: browser, or over SSH open the link\n    anywhere, allow, paste the code shown\n 2. Install ~/.parallax-plxd + service (0072)\n 3. relay/register; plxd records account sub\n 4. Turn on relay and remote; show a 6-digit\n    code to type in the app on another device\n Also: plx connect unlink | remove | status | add",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TXHgJMflMKoau1_9xPJSW",
      "type": "text",
      "x": 1515,
      "y": 613,
      "width": 322.9892578125,
      "height": 337.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
