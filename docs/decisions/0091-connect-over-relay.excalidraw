    {
      "id": "km98tkn8LcRT6f2zkO_p6",
      "type": "text",
      "x": 1515,
      "y": 405,
      "width": 340.751953125,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
