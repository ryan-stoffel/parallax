      "updated": 1793371563945,
      "link": null,
      "locked": false,
      "text": " Migration, first release\n - connect on: relay and remote turn on, unless the user chose\n - The signed-in app registers B (PLX-1146)\n - A tailnet: connection drops once the same key answers as\n   account:, matched by the relay id plxd reports (relay/id)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "migr",
      "originalText": " Migration, first release\n - connect on: relay and remote turn on, unless the user chose\n - The signed-in app registers B (PLX-1146)\n - A tailnet: connection drops once the same key answers as\n   account:, matched by the relay id plxd reports (relay/id)",
      "autoResize": true,
      "lineHeight": 1.25
    }
