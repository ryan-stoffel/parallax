      "boundElements": null,
      "updated": 1793336890387,
      "link": null,
      "locked": false,
      "text": " Worker (router)\n POST /v1/hosts: register, key-signed\n GET /v1/hosts: the account's host list\n POST /v1/hosts/:id/tickets: 30 s, used once\n DELETE /v1/hosts/:id: remove a host\n GET /connect/code: shows a sign-in code to paste",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "worker",
      "originalText": " Worker (router)\n POST /v1/hosts: register, key-signed\n GET /v1/hosts: the account's host list\n POST /v1/hosts/:id/tickets: 30 s, used once\n DELETE /v1/hosts/:id: remove a host\n GET /connect/code: shows a sign-in code to paste",
      "autoResize": true,
      "lineHeight": 1.25
    },
