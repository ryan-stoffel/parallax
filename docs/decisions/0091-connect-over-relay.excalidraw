    {
      "id": "DynSpOrzZPKGr-Ww4TREC",
      "type": "text",
      "x": 55,
      "y": 405,
      "width": 386.3671875,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
