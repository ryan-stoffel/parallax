      "link": null,
      "locked": false,
      "text": " plxd A (local, trusted socket)\n - relay/hosts, relay/register, relay/sign\n - plxd dial: accepts B's certificate only\n   if its key's JWK thumbprint == hostId\n - DPoP key; one session per host after\n   the first sign-in",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "plxdA",
      "originalText": " plxd A (local, trusted socket)\n - relay/hosts, relay/register, relay/sign\n - plxd dial: accepts B's certificate only\n   if its key's JWK thumbprint == hostId\n - DPoP key; one session per host after\n   the first sign-in",
      "autoResize": true,
      "lineHeight": 1.25
    },
