From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Stoffel <stoffel.thomas.ryan@gmail.com>
Date: Sun, 27 Sep 2026 02:56:26 +0000
Subject: [PATCH] chat: show the repository in the session header

The session header's title row is a thread breadcrumb: the repository,
the title, and a state word. Clicking the repository runs
wisp.filterSidebarRepository. The overlay supplies the words through
setSessionHeaderDecorationReader, so this patch stays a render hook.

Issue #302.

diff --git a/src/vs/sessions/browser/parts/sessionHeader.ts b/src/vs/sessions/browser/parts/sessionHeader.ts
index bfa87916c863b9f5e0707b4bf39bb40f01691e2b..231ac61f665aa54b5ef39fc018374a7c81d73a1e 100644
--- a/src/vs/sessions/browser/parts/sessionHeader.ts
+++ b/src/vs/sessions/browser/parts/sessionHeader.ts
@@ -27,8 +27,28 @@ import { IContextKeyService } from '../../../platform/contextkey/common/contextk
 import { onUnexpectedError } from '../../../base/common/errors.js';
 import { SessionStatusIcon } from '../sessionStatusIcon.js';
 import { IConfigurationService } from '../../../platform/configuration/common/configuration.js';
+import { ICommandService } from '../../../platform/commands/common/commands.js';
 import { createSessionActionViewItemProvider } from '../sessionActionViewItem.js';
 
+/** Overlay command: clicking the repository crumb filters wisp's sidebar (#302). */
+const FILTER_SIDEBAR_REPOSITORY_COMMAND = 'wisp.filterSidebarRepository';
+
+/** The repository crumb and state word an overlay can supply for one session. */
+export interface ISessionHeaderDecoration {
+	readonly repository: string | undefined;
+	readonly repositoryKey: string | undefined;
+	readonly state: { readonly word: string; readonly mark: string } | undefined;
+}
+
+export type SessionHeaderDecorationReader = (session: IActiveSession, reader: IReader) => ISessionHeaderDecoration | undefined;
+
+let sessionHeaderDecorationReader: SessionHeaderDecorationReader | undefined;
+
+/** Registers who fills the repository crumb and the state word. One reader; the overlay owns the mapping. */
+export function setSessionHeaderDecorationReader(reader: SessionHeaderDecorationReader | undefined): void {
+	sessionHeaderDecorationReader = reader;
+}
+
 /**
  * The session header shown at the top of a session view. It surfaces the active
  * chat title and session toolbar.
@@ -43,6 +63,9 @@ export class SessionHeader extends Disposable {
 	private readonly _iconEl: HTMLElement;
 	private readonly _titleEl: HTMLElement;
 	private readonly _titleTextEl: HTMLElement;
+	private readonly _workspaceEl: HTMLButtonElement;
+	private readonly _sepEl: HTMLElement;
+	private readonly _stateEl: HTMLElement;
 	private readonly _toolbar: MenuWorkbenchToolBar;
 	private readonly _titleActionsEl: HTMLElement;
 
@@ -50,6 +73,7 @@ export class SessionHeader extends Disposable {
 	private readonly _editingDisposables = this._register(new MutableDisposable<DisposableStore>());
 	private _renameInput: HTMLInputElement | undefined;
 	private _session: IActiveSession | undefined;
+	private _repositoryKey: string | undefined;
 	private _activeChat: IChat | undefined;
 	private _sessionIsCreated = false;
 	private _requestedVisible = true;
@@ -89,6 +113,7 @@ export class SessionHeader extends Disposable {
 		@IContextKeyService private readonly _contextKeyService: IContextKeyService,
 		@ISessionsManagementService private readonly _sessionsManagementService: ISessionsManagementService,
 		@IConfigurationService configurationService: IConfigurationService,
+		@ICommandService private readonly _commandService: ICommandService,
 	) {
 		super();
 
@@ -108,14 +133,38 @@ export class SessionHeader extends Disposable {
 		const titleRow = $('.chat-composite-bar-title-row');
 		main.appendChild(titleRow);
 
+		// Repository / title, then the state word. The overlay fills both (#302).
+		const crumb = $('nav.chat-composite-bar-session-crumb', { 'aria-label': localize('sessionHeader.thread', "Thread") });
+		titleRow.appendChild(crumb);
+
+		this._workspaceEl = $<HTMLButtonElement>('button.chat-composite-bar-session-workspace', { type: 'button' });
+		this._workspaceEl.style.display = 'none';
+		crumb.appendChild(this._workspaceEl);
+		this._register(addDisposableListener(this._workspaceEl, EventType.CLICK, e => {
+			e.preventDefault();
+			e.stopPropagation();
+			const key = this._repositoryKey;
+			if (key) {
+				this._commandService.executeCommand(FILTER_SIDEBAR_REPOSITORY_COMMAND, key).catch(onUnexpectedError);
+			}
+		}));
+
+		this._sepEl = $('span.chat-composite-bar-session-sep', undefined, '/');
+		this._sepEl.style.display = 'none';
+		crumb.appendChild(this._sepEl);
+
 		this._titleEl = $('.chat-composite-bar-session-title');
-		titleRow.appendChild(this._titleEl);
+		crumb.appendChild(this._titleEl);
 
 		// Wrap the title text in a span so we can swap it for an input when
 		// the user clicks to rename without rebuilding the title slot itself.
 		this._titleTextEl = $('span.chat-composite-bar-session-title-text');
 		this._titleEl.appendChild(this._titleTextEl);
 
+		this._stateEl = $('span.chat-composite-bar-session-state');
+		this._stateEl.style.display = 'none';
+		crumb.appendChild(this._stateEl);
+
 		// Click the title to start an inline rename. Click is preferred over
 		// mousedown so that initiating a drag from the title doesn't also
 		// flip into edit mode.
@@ -187,9 +236,9 @@ export class SessionHeader extends Disposable {
 				return;
 			}
 
-			// Don't swallow a click on the toolbar into a session drag.
+			// Don't swallow a click on the toolbar, the repository, or the state into a session drag.
 			const target = this._lastPointerDownTarget;
-			if (target && this._titleActionsEl.contains(target)) {
+			if (target && (this._titleActionsEl.contains(target) || this._workspaceEl.contains(target) || this._stateEl.contains(target))) {
 				e.preventDefault();
 				return;
 			}
@@ -277,8 +326,28 @@ export class SessionHeader extends Disposable {
 			this._cancelTitleEditing();
 			this._activeChat = activeChat;
 		}
-		this._titleTextEl.textContent = activeChat.title.read(reader) || getUntitledSessionTitle(true);
+		const title = activeChat.title.read(reader) || getUntitledSessionTitle(true);
+		this._titleTextEl.textContent = title;
 		this._titleEl.classList.toggle('editable', this._isTitleEditable(reader));
+
+		const workspace = session.workspace.read(reader);
+		const decoration = sessionHeaderDecorationReader?.(session, reader);
+		const repository = decoration ? decoration.repository : workspace?.label;
+		this._repositoryKey = decoration ? decoration.repositoryKey : workspace?.uri.toString();
+		this._workspaceEl.textContent = repository ?? '';
+		this._workspaceEl.style.display = repository ? '' : 'none';
+		this._sepEl.style.display = repository ? '' : 'none';
+
+		const state = decoration?.state;
+		this._stateEl.textContent = state?.word ?? '';
+		if (state) {
+			this._stateEl.dataset.mark = state.mark;
+			this._stateEl.style.display = '';
+		} else {
+			delete this._stateEl.dataset.mark;
+			this._stateEl.style.display = 'none';
+		}
+		this._titleEl.setAttribute('aria-label', state ? localize('sessionHeader.titleWithState', "{0}, {1}", title, state.word) : title);
 		this._onDidChangeHeight.fire();
 	}
 
