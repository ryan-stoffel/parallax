From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Stoffel <stoffel.thomas.ryan@gmail.com>
Date: Sun, 27 Sep 2026 07:43:37 +0000
Subject: [PATCH] build: skip Windows signing when signtool is absent


diff --git a/build/gulpfile.vscode.ts b/build/gulpfile.vscode.ts
index a65d535b381eda2cfd5f345b68eeaa6240e62b64..2b6f2deff22873f7e2c464fc6846ec143ed41c72 100644
--- a/build/gulpfile.vscode.ts
+++ b/build/gulpfile.vscode.ts
@@ -471,6 +471,21 @@ function packageTask(platform: string, arch: string, sourceFolderName: string, d
 	return task;
 }
 
+function signtoolAvailable(): Promise<boolean> {
+	return new Promise(resolve => {
+		let settled = false;
+		const done = (available: boolean) => {
+			if (!settled) {
+				settled = true;
+				resolve(available);
+			}
+		};
+		const proc = cp.spawn('signtool.exe', ['/?'], { stdio: 'ignore' });
+		proc.on('error', () => done(false));
+		proc.on('exit', () => done(true));
+	});
+}
+
 function hasAuthenticodeSignature(filePath: string): Promise<boolean> {
 	return new Promise((resolve, reject) => {
 		const proc = cp.spawn('signtool.exe', ['verify', '/pa', filePath]);
@@ -507,6 +522,13 @@ function patchWin32DependenciesTask(destinationFolderName: string) {
 	const cwd = path.join(path.dirname(root), destinationFolderName);
 
 	return async () => {
+		// No signing certificate in this build. signtool strips Authenticode so rcedit
+		// can rewrite version resources; without it, leave the packaged binaries as packageTask wrote them.
+		if (!await signtoolAvailable()) {
+			console.log('signtool.exe is not on PATH; skipping Windows binary patching and signing');
+			return;
+		}
+
 		const versionedResourcesFolder = util.getVersionedResourcesFolder('win32', commit!);
 		const deps = (await Promise.all([
 			glob('**/*.node', { cwd, ignore: 'extensions/node_modules/@parcel/watcher/**' }),
