From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Stoffel <stoffel.thomas.ryan@gmail.com>
Date: Sun, 27 Sep 2026 04:55:07 +0000
Subject: [PATCH] workbench: open an empty window

Boot does not create workbench parts. startup() opens the shell and
returns, so the sidebar, activity bar, panel, title bar, editor,
sessions surface, status bar, and notifications are never constructed.
The native window controller is not started, because constructing it
creates the title bar and editor parts. The BrowserWindow is frameless,
so there is no native title bar or traffic lights either.

Issue #316.

diff --git a/src/vs/platform/windows/electron-main/windows.ts b/src/vs/platform/windows/electron-main/windows.ts
index aefb5d3eee8a1435f8d2a92f60748d7a7d7eabac..60c1b4390edf37be9be4070e7c13d19d238b0dc6 100644
--- a/src/vs/platform/windows/electron-main/windows.ts
+++ b/src/vs/platform/windows/electron-main/windows.ts
@@ -246,6 +246,13 @@ export function defaultBrowserWindowOptions(accessor: ServicesAccessor, windowSt
 		options.minHeight = 1;
 	}
 
+	// wisp: no native title bar or traffic lights. The in-page title bar is not created.
+	options.frame = false;
+	options.titleBarStyle = undefined;
+	options.titleBarOverlay = undefined;
+	options.minWidth = 1;
+	options.minHeight = 1;
+
 	if (overrides?.backgroundColor) {
 		options.backgroundColor = overrides.backgroundColor;
 	}
