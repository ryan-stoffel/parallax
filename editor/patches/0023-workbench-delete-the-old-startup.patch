From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Stoffel <stoffel.thomas.ryan@gmail.com>
Date: Sun, 27 Sep 2026 05:34:17 +0000
Subject: [PATCH] workbench: delete the old startup

startup() only opens the empty window. The code that built the sidebar,
activity bar, panel, title bar, editor, and sessions surface is not left
under a return. The native window has no title bar or traffic lights.

Issue #316.

diff --git a/src/vs/platform/windows/electron-main/windowImpl.ts b/src/vs/platform/windows/electron-main/windowImpl.ts
index 4a4172f5834ed5b9452363ad94fcd4ebb5333570..41df00d60e40552a244745c33589ca16ce8a9ece 100644
--- a/src/vs/platform/windows/electron-main/windowImpl.ts
+++ b/src/vs/platform/windows/electron-main/windowImpl.ts
@@ -803,6 +803,12 @@ export class CodeWindow extends BaseWindow implements ICodeWindow {
 
 			this._id = this._win.id;
 			this.setWin(this._win, options);
+			// wisp: frameless windows on macOS still draw traffic lights until
+			// this is called, and load() must not put the product name back.
+			if (isMacintosh) {
+				this._win.setWindowButtonVisibility(false);
+			}
+			this._win.setTitle('');
 
 			// Apply some state after window creation
 			this.applyState(this.windowState, hasMultipleDisplays);
@@ -1264,7 +1270,11 @@ export class CodeWindow extends BaseWindow implements ICodeWindow {
 				this.setRepresentedFilename('');
 			}
 
-			this._win.setTitle(this.productService.nameLong);
+			// wisp: no native title text (#316).
+			this._win.setTitle('');
+			if (isMacintosh) {
+				this._win.setWindowButtonVisibility(false);
+			}
 		}
 
 		// Update configuration values based on our window context
diff --git a/src/vs/platform/windows/electron-main/windows.ts b/src/vs/platform/windows/electron-main/windows.ts
index 60c1b4390edf37be9be4070e7c13d19d238b0dc6..51e59137645ee791daf723adbd42208569392313 100644
--- a/src/vs/platform/windows/electron-main/windows.ts
+++ b/src/vs/platform/windows/electron-main/windows.ts
@@ -246,10 +246,14 @@ export function defaultBrowserWindowOptions(accessor: ServicesAccessor, windowSt
 		options.minHeight = 1;
 	}
 
-	// wisp: no native title bar or traffic lights. The in-page title bar is not created.
+	// wisp: no native title bar, title text, or traffic lights. The in-page
+	// title bar is not created. `titleBarStyle: 'hidden'` would keep the
+	// traffic lights, so that property is removed rather than left set.
 	options.frame = false;
-	options.titleBarStyle = undefined;
-	options.titleBarOverlay = undefined;
+	delete options.titleBarStyle;
+	delete options.titleBarOverlay;
+	options.title = '';
+	options.trafficLightPosition = { x: -150, y: -150 };
 	options.minWidth = 1;
 	options.minHeight = 1;
 
