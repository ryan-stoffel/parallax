+	/**
+	 * The provider's empty-thread presentation, or `undefined` when it has none.
+	 * Pass a reader from an autorun so the heading follows the draft and the workspace.
+	 */
+	private _queryEmptyThread(reader?: IReader): INewChatEmptyThread | undefined {
+		const session = reader ? this._session.read(reader) : this._session.get();
+		const quickChat = reader ? this._isQuickChatComposer.read(reader) : this._isQuickChatComposer.get();
+		const providers = this.sessionsProvidersService.getProviders();
+		const sessionProvider = session ? this.sessionsProvidersService.getProvider(session.providerId) : undefined;
+		// The draft's own provider goes first. A draft from another host (the composer is created
+		// before wisp registers, and may then belong to Copilot) still picks up a provider that
+		// implements the empty thread.
+		const candidates = sessionProvider
+			? [sessionProvider, ...providers.filter(provider => provider !== sessionProvider)]
+			: providers;
+		for (const provider of candidates) {
+			const getEmptyThread = (provider as Partial<INewChatEmptyThreadProvider> | undefined)?.getEmptyThread;
+			if (typeof getEmptyThread !== 'function') {
+				continue;
+			}
+			const workspace = session ? (reader ? session.workspace.read(reader) : session.workspace.get()) : undefined;
+			return getEmptyThread.call(provider, {
+				quickChat,
+				sessionTypeId: session?.sessionType,
+				workspaceLabel: quickChat ? undefined : workspace?.label ?? this._workspacePicker.selectedResolved?.workspace.label,
+				sessionTitle: session ? (reader ? session.title.read(reader) : session.title.get()) : undefined,
+			});
+		}
+		return undefined;
+	}
+
+	private _fillEmptyHeading(heading: HTMLElement, presentation: INewChatEmptyThread, reader: IReaderWithStore): void {
+		dom.clearNode(heading);
+		for (const segment of presentation.heading) {
+			if (!segment.link) {
+				dom.append(heading, segment.text);
+				continue;
+			}
+			const button = dom.append(heading, dom.$('button.new-chat-empty-heading-name')) as HTMLButtonElement;
+			button.type = 'button';
+			button.textContent = segment.text;
+			button.title = localize('newChat.emptyThread.repository', "Choose a repository");
+			button.setAttribute('aria-haspopup', 'true');
+			button.style.cssText = 'font:inherit;color:inherit;background:none;border:none;padding:0;cursor:pointer;text-decoration:underline dotted;text-underline-offset:4px';
+			reader.store.add(dom.addDisposableListener(button, dom.EventType.CLICK, () => {
+				this._workspacePicker.showPicker(false, button);
+			}));
+		}
+	}
+
