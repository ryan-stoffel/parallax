[
  { "init": { "sessionId": "e2e-device", "model": "fake-model" } },
  {
    "emit": {
      "kind": "toolCall",
      "callId": "toolu_device",
      "name": "mcp__plxd__device_open",
      "input": { "platform": "ios" }
    }
  },
  {
    "emit": {
      "kind": "toolResult",
      "callId": "toolu_device",
      "status": "ok",
      "output": "{\"device\": {\"hostId\": \"local\", \"id\": \"E2E-SIM\", \"platform\": \"ios\", \"name\": \"iPhone 17 Pro\", \"version\": \"iOS 26.5\", \"booted\": true, \"physical\": false}, \"quickStart\": \"\"}"
    }
  },
  { "emit": { "kind": "text", "text": "The simulator is open." } },
  { "endTurn": {} }
]
