{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": [],
    // The desktop files mobile shares (metro.config.js) import React, resolved here as Metro does.
    // Types only: app.json turns off Expo's use of these paths in Metro.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["index.ts", "src", "modules/*/index.ts", "../desktop/src/renderer/parallax.d.ts"],
  "exclude": ["src/**/*.test.ts"]
}
