#!/bin/sh
# Builds the app's installer and its update metadata for this OS and arch into
# apps/desktop/release/ (0029, 0030): a release `wispd` for the target, the app's dist/, then
# electron-builder. WISP_VERSION is the version to stamp into the build (default 0.0.0-local); it
# is never committed. Unsigned unless CSC_LINK is set, which on macOS signs with that certificate
# (and notarizes if APPLE_API_KEY, APPLE_API_KEY_ID, and APPLE_API_ISSUER are set too).
set -eu

cd "$(dirname "$0")/../.."

# Without CSC_LINK, don't pick up a Developer ID from the local keychain. With it, electron-builder
# signs with that certificate, which auto-discovery must stay on for. Checked before `set -x`, so
# the certificate never reaches the log.
if [ -z "${CSC_LINK:-}" ]; then
  export CSC_IDENTITY_AUTO_DISCOVERY=${CSC_IDENTITY_AUTO_DISCOVERY:-false}
fi
set -x

version=${WISP_VERSION:-0.0.0-local}

# wispd is built for the runner's own arch. Linux ships the static musl build (0023).
host=$(rustc -vV | sed -n 's/^host: //p')
arch=${host%%-*}
triple=$host
if [ "$(uname -s)" = Linux ]; then
  triple=$arch-unknown-linux-musl
  rustup target add "$triple"
fi
cargo build --release --locked -p wispd --target "$triple"

case $arch in
  aarch64) builder_arch=--arm64 ;;
  x86_64) builder_arch=--x64 ;;
  *) echo "package-app: no installer for $arch" >&2; exit 1 ;;
esac
exe=
case $host in *-windows-*) exe=.exe ;; esac

cd apps/desktop
node --version
pnpm --version
pnpm install --frozen-lockfile
pnpm build
# electron-builder.yml copies WISPD_BIN, relative to apps/desktop, into the app's resources.
WISPD_BIN=../../target/$triple/release/wispd$exe pnpm exec electron-builder \
  --publish never "$builder_arch" -c.extraMetadata.version="$version"
