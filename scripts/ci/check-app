#!/bin/sh
set -eu

cd "$(dirname "$0")/../../apps/desktop"
set -x

node --version
pnpm --version
pnpm install --frozen-lockfile
pnpm check
pnpm test
pnpm build

# plx, the npm package (plx-cli) that sets up Parallax Connect on a computer (0091).
cd ../../packages/plx
npm ci
npm run check
npm test

# clerk-verify, the Parallax account token check the relay shares (0067).
cd ../clerk-verify
npm ci
npm run check
npm test
