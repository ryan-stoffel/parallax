#!/bin/sh
set -eu

# The emulator's half of the phone app's Android check (PLX-1370), once android-build has built it
# and with an emulator running: the real app and pinned-tls on the emulator against a fake-backend
# plxd and Parallax Relay under `wrangler dev` (apps/mobile/e2e/android.mjs). Screenshots go in
# ANDROID_E2E_OUT.
cd "$(dirname "$0")/../../apps/mobile"
set -x

node e2e/android.mjs
