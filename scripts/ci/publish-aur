#!/usr/bin/env bash
# Points the AUR's parallax-nightly-bin at the nightly TAG (release.yml's aur job, PLX-889), so
# `yay -S parallax-nightly-bin` installs it and `yay` updates to it: sets packaging/aur/PKGBUILD's
# pkgver and sha256sums from the digests GitHub keeps for the release's two AppImages, writes
# .SRCINFO with makepkg in an Arch container, and pushes both to the AUR. A release missing an
# AppImage, because its Linux build failed, leaves the AUR on the last nightly.
#
# Environment: TAG, GH_TOKEN and GH_REPO for gh, and AUR_SSH_PRIVATE_KEY, the SSH key of the AUR
# account that maintains the package; without it, nothing is pushed. DRY_RUN=1 uses placeholder
# sums (workflow_dispatch has no release) and prints the files instead of pushing.
set -euo pipefail

version=${TAG#v}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cp "$(dirname "$0")/../../packaging/aur/PKGBUILD" "$work/"

if [ "${DRY_RUN:-}" = 1 ]; then
  x86_64=$(printf '0%.0s' {1..64})
  aarch64=$x86_64
else
  assets=$(gh api "repos/$GH_REPO/releases/tags/$TAG")
  digest() {
    jq -r --arg name "parallax-$version-linux-$1.AppImage" \
      '.assets[] | select(.name == $name) | .digest | ltrimstr("sha256:")' <<< "$assets"
  }
  x86_64=$(digest x86_64)
  aarch64=$(digest arm64)
  if ! [[ $x86_64 =~ ^[0-9a-f]{64}$ && $aarch64 =~ ^[0-9a-f]{64}$ ]]; then
    echo "::notice::$TAG is missing a Linux AppImage, so the AUR stays on the last nightly."
    exit 0
  fi
fi

sed -i -e "s/^pkgver=.*/pkgver=${version%-nightly}/" -e "s/^pkgrel=.*/pkgrel=1/" \
  -e "s/^sha256sums_x86_64=.*/sha256sums_x86_64=($x86_64)/" \
  -e "s/^sha256sums_aarch64=.*/sha256sums_aarch64=($aarch64)/" "$work/PKGBUILD"
# makepkg refuses to run as root.
docker run --rm -u "$(id -u):$(id -g)" -v "$work:/pkg" -w /pkg archlinux:base-devel \
  makepkg --printsrcinfo > "$work/.SRCINFO"

if [ "${DRY_RUN:-}" = 1 ]; then
  echo "dry run: push to the AUR's parallax-nightly-bin:"
  cat "$work/PKGBUILD" "$work/.SRCINFO"
  exit 0
fi
if [ -z "${AUR_SSH_PRIVATE_KEY:-}" ]; then
  echo "::notice::No AUR_SSH_PRIVATE_KEY secret, so the AUR stays on the last nightly."
  exit 0
fi

# The AUR's Ed25519 host key, whose fingerprint aur.archlinux.org lists:
# SHA256:RFzBCUItH9LZS0cKB5UE6ceAYhBD5C8GeOBip8Z11+4.
echo 'aur.archlinux.org ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEuBKrPzbawxA/k2g6NcyV5jmqwJ2s+zpgZGZ7tpLIcN' \
  > "$work/known_hosts"
(umask 077 && printf '%s\n' "$AUR_SSH_PRIVATE_KEY" > "$work/key")
export GIT_SSH_COMMAND="ssh -i $work/key -o IdentitiesOnly=yes -o UserKnownHostsFile=$work/known_hosts -o StrictHostKeyChecking=yes"

# The first push creates the package.
git clone -q ssh://aur@aur.archlinux.org/parallax-nightly-bin.git "$work/aur"
cp "$work/PKGBUILD" "$work/.SRCINFO" "$work/aur/"
cd "$work/aur"
git add PKGBUILD .SRCINFO
if git diff --cached --quiet; then
  echo "The AUR already has $version."
  exit 0
fi
git -c user.name="Ryan Stoffel" -c user.email=stoffel.thomas.ryan@gmail.com commit -qm "Update to $version"
git push -q origin HEAD:master
echo "The AUR's parallax-nightly-bin is now $version."
