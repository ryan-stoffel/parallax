#!/usr/bin/env bash
# Attaches this build's installer and update metadata, from apps/desktop/release/, to the release
# TAG, which release.yml's plan job created as a draft, then publishes the release (0028, 0029).
# Each build runs it as soon as its own package is ready, so the first OS done makes the release
# visible and no OS waits for another.
#
# Environment: TAG, CHANNEL (nightly or latest), and GH_TOKEN and GH_REPO for gh. DRY_RUN=1 prints
# each write instead of making it, and treats the release as empty (workflow_dispatch, which has
# none).
set -euo pipefail

cd "$(dirname "$0")/../../apps/desktop/release"

write() {
  if [ "${DRY_RUN:-}" = 1 ]; then echo "dry run: gh $*"; else gh "$@"; fi
}

# The installers, the macOS zip, the blockmaps, and plxd for SSH hosts; then the channel's update metadata.
files=()
for f in parallax-*; do [ -f "$f" ] && files+=("$f"); done
if [ ${#files[@]} = 0 ]; then echo "publish-build: no installer in $PWD" >&2; exit 1; fi
# Both Windows builds write <channel>.yml. Each attaches its own as <channel>-win-<arch>.yml, which
# no updater reads, and release.yml's finish job joins the two from the release into <channel>.yml.
if [ -f "$CHANNEL.yml" ]; then
  exe=(parallax-*-win-*.exe)
  [ -f "${exe[0]}" ] || { echo "publish-build: $CHANNEL.yml without a Windows installer" >&2; exit 1; }
  arch=${exe[0]##*-win-}
  mv "$CHANNEL.yml" "$CHANNEL-win-${arch%.exe}.yml"
fi
metadata=()
for f in "$CHANNEL"*.yml; do [ -f "$f" ] && metadata+=("$f"); done

if [ "${DRY_RUN:-}" = 1 ]; then
  existing=
else
  existing=$(gh release view "$TAG" --json assets --jq '.assets[].name')
fi

# A build whose files are all attached already (a re-run) leaves them alone, so a rebuilt
# installer never replaces the one the release's metadata describes.
missing=0
for f in "${files[@]}" ${metadata[@]+"${metadata[@]}"}; do grep -qxF -- "$f" <<< "$existing" || missing=1; done
if [ "$missing" = 0 ]; then
  echo "This build's files are already on $TAG."
else
  # The metadata goes last, so an updater never finds it before the files it names. A failed upload
  # fails the job and leaves the metadata off; re-running the job replaces what did arrive.
  write release upload "$TAG" "${files[@]}" --clobber
  if [ ${#metadata[@]} -gt 0 ]; then write release upload "$TAG" "${metadata[@]}" --clobber; fi
fi

# Publishing creates the tag at the commit plan named. Every build does it once its own files are
# there, so a failed build only leaves its OS out. Nightly is a prerelease, set by plan; standard
# is marked Latest (0028).
if [ "$CHANNEL" = latest ]; then
  write release edit "$TAG" --draft=false --latest
else
  write release edit "$TAG" --draft=false
fi
