#!/bin/sh
# Runs the desktop app's end-to-end tests (RYA-16): builds the app, then runs Playwright in
# apps/desktop/e2e against the wispd at WISPD_PATH. With WISPD_PATH unset it builds wispd with its
# fake backend first (CI passes the rust job's build instead, RYA-25).
set -eu

cd "$(dirname "$0")/../.."
set -x

if [ -z "${WISPD_PATH:-}" ]; then
  cargo build -p wispd --locked --features fake-backend
  export WISPD_PATH="$PWD/target/debug/wispd"
fi

cd apps/desktop
pnpm install --frozen-lockfile
pnpm build
# Electron needs a display; a Linux runner has none.
if [ "$(uname)" = Linux ] && [ -z "${DISPLAY:-}" ]; then
  xvfb-run -a pnpm e2e
else
  pnpm e2e
fi
