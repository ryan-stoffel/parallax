#!/bin/sh
# Runs the desktop app's end-to-end tests (PLX-16): builds the app, then runs Playwright in
# apps/desktop/e2e against the plxd at PLXD_PATH. With PLXD_PATH unset it builds plxd with its
# fake backend first (CI passes the rust job's build instead, PLX-25).
set -eu

cd "$(dirname "$0")/../.."
set -x

if [ -z "${PLXD_PATH:-}" ]; then
  cargo build -p plxd --locked --features fake-backend
  export PLXD_PATH="$PWD/target/debug/plxd"
fi

cd apps/desktop
pnpm install --frozen-lockfile
pnpm build
# Electron needs a display; a Linux runner has none.
if [ "$(uname)" = Linux ] && [ -z "${DISPLAY:-}" ]; then
  xvfb-run -a pnpm e2e
else
  pnpm e2e
fi
