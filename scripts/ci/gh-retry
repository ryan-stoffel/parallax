#!/usr/bin/env bash
# Runs gh with the given arguments, trying again with a growing wait when it fails, and exits with
# the last try's status. GitHub sometimes answers a release read or write with a 500 or a 404 for a
# few minutes (PLX-1430), and one such answer shouldn't fail a build that took twenty. Every call
# through this must be safe to repeat, so an upload or a download needs --clobber: a failed try can
# leave its file behind, and a 500 can come after the file arrived. Only the last try's stdout comes
# out, since gh api prints an error's body there and a caller reads stdout as the answer. A failed
# earlier try's goes to stderr.
#
# Environment: GH_RETRY_WAITS, the seconds to wait before each new try, for tests.
set -uo pipefail

out=$(mktemp)
trap 'rm -f "$out"' EXIT

for wait in ${GH_RETRY_WAITS:-15 45 120}; do
  if gh "$@" > "$out"; then
    cat "$out"
    exit 0
  fi
  cat "$out" >&2
  echo "gh-retry: gh $1 ${2:-} failed. Trying again in ${wait}s." >&2
  sleep "$wait"
done
gh "$@" > "$out"
status=$?
cat "$out"
exit "$status"
